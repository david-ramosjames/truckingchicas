# Phone number for the firm (used across the site)
NEXT_PUBLIC_PHONE_NUMBER=5125551234
NEXT_PUBLIC_PHONE_DISPLAY=(512) 555-1234

# Google Analytics 4
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# CallRail Dynamic Number Insertion (swap.js)
# Public CDN script — safe to expose. A working default is baked into the app,
# so set this only to override (e.g. a different account for staging).
NEXT_PUBLIC_CALLRAIL_SWAP_URL=//cdn.callrail.com/companies/216293871/ad2813723ab06a1e1a24/12/swap.js

# CallRail REST API — SERVER-SIDE SECRETS, never commit real values.
# Only needed if/when we pull call + lead data from CallRail's API.
# CALLRAIL_ACCOUNT_ID=
# CALLRAIL_API_KEY=

# Chatbot LLM provider key (OpenAI or compatible)
OPENAI_API_KEY=sk-...

# Slack webhooks (dual channel)
# #tc-leads — qualified leads (phone captured, likely case, call request)
SLACK_LEADS_WEBHOOK_URL=your-leads-webhook-url
# #tc-chat-log — all conversation summaries
SLACK_LOG_WEBHOOK_URL=your-chat-log-webhook-url
# Fallback if specific URLs not set
SLACK_WEBHOOK_URL=your-fallback-webhook-url

# Site URL for canonical tags
NEXT_PUBLIC_SITE_URL=https://truckingchicas.com
